# Kisan Sathi GitIgnore Configuration

# Dependency Directories
node_modules/
jspm_packages/
web_modules/

# Logs and Debug outputs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
tmp/
temp/

# Build and Compilation outputs
dist/
build/
coverage/
*.tsbuildinfo

# OS Metadata
.DS_Store
Thumbs.db
desktop.ini

# Environment Configuration and Secrets
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
*.p12
*.p8
*.dump
*.sql.gz

# Expo / React Native generated outputs
.expo/
.expo-shared/
web-build/

# Native builds outputs (Android/iOS builds outputs)
android/.gradle/
android/app/build/
android/build/
ios/build/

# Local IDE configuration user-state
*.code-workspace.user
.vscode/tasks.json
.vscode/launch.json
